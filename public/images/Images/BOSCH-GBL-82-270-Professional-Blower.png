            <script type="text/javascript">(function(f) {var _np=(window.P._namespace("priceTrackerIngress"));if(_np.guardFatal){_np.guardFatal(f)(_np);}else{f(_np);}}(function(P) { 
                P.when('A', 'dp-latency-marker').execute(function (A) {
                
                // ue.rid used to identify unique page load for cases with multiple ingresses on same page
                    var currentPageId = (typeof ue !== 'undefined' && ue.rid) ? ue.rid : '';
                    var treatmentSuffix = "pll-both";

                    // Total renders (fires for EVERY ingress rendered)
                    if (window.ue && window.ue.count) {
                        window.ue.count("rufusPricingIngress:desktop:render:counter", 1);
                    }

                    // Deduplication
                    if (!window.rufusPricingIngressPageTracked || window.rufusPricingIngressPageId !== currentPageId) {
                        window.rufusPricingIngressPageTracked = true;
                        window.rufusPricingIngressPageId = currentPageId;

                        // total pages loaded where ingress was called at least once
                        if (window.ue && window.ue.count) {
                            window.ue.count("rufusPricingIngress:desktop:pageLoad:counter", 1);
                        }
                        // Remove with RUFUS_PRICING_DESKTOP_DP_PROMINENT_INGRESS_1363320 cleanup
                        if (window.ue && window.ue.count && treatmentSuffix) {
                            window.ue.count("rufusPricingIngress:desktop:pageLoad:" + treatmentSuffix, 1);
                        }
                    }

                    if (uet) {
                        uet('cf', "rufusPricingIngress:desktop:render:latency", {wb: 1});
                    }

                    // need to ensure clickHandler is only registered once to avoid duplicate link triggers
                    if (!window.rufusPricingIngressClickHandlerRegistered
                            || window.rufusPricingIngressClickHandlerPageId !== currentPageId) {
                        window.rufusPricingIngressClickHandlerRegistered = true;
                        window.rufusPricingIngressClickHandlerPageId = currentPageId;

                        A.declarative('show-rufus-price-ingress', 'click', function(event){
                            event.$event.preventDefault();

                            var clickedElement = event.$target.closest('[data-ingress-position]');
                            var position = clickedElement ? clickedElement.attr('data-ingress-position') : 'unknown';
                            var refMarker = clickedElement ? clickedElement.attr('data-ref-marker') : '';

                            // total clicks
                            if (window.ue && window.ue.count) {
                                window.ue.count("rufusPricingIngress:desktop:click", 1);
                            }

                            if (uet) {
                                uet('bb', "rufusPricingIngress:desktop:clickAction:latency", {wb: 1});
                            }
                            let rufusPriceDomElement = clickedElement ? clickedElement[0] : document.querySelector('[id^="rufus-price-ingress"]');
                            let csaElement = (window.csa && rufusPriceDomElement) ? window.csa('Content', {element: rufusPriceDomElement}) : undefined;
                            let dataset = rufusPriceDomElement?.dataset || {};
                            let ingressQueryText = dataset.queryText || "Price History";

                            if(csaElement) {
                                csaElement(
                                    'mark',
                                    'render-start',
                                    performance.now()
                                );
                            }
                            // Clicks by position
                            if (window.ue && window.ue.count) {
                                window.ue.count("rufusPricingIngress:desktop:click:" + position, 1);
                            }

                            // Clicks by treatment
                            // Remove with RUFUS_PRICING_DESKTOP_DP_PROMINENT_INGRESS_1363320 cleanup
                            if (window.ue && window.ue.count && treatmentSuffix) {
                                window.ue.count("rufusPricingIngress:desktop:click:" + treatmentSuffix, 1);
                            }

                            // unique click per page load (only counts once no matter how often ingress clicked on same page)
                            if (!window.rufusPricingIngressClickTracked || window.rufusPricingIngressClickPageId !== currentPageId) {
                                window.rufusPricingIngressClickTracked = true;
                                window.rufusPricingIngressClickPageId = currentPageId;

                                // can be used to track which position clicked first
                                // can be aggregated to get total pages clicked on
                                if (window.ue && window.ue.count && position) {
                                    window.ue.count("rufusPricingIngress:desktop:uniqueClick:" + position, 1);
                                }
                                // Remove with RUFUS_PRICING_DESKTOP_DP_PROMINENT_INGRESS_1363320 cleanup
                                if (window.ue && window.ue.count && treatmentSuffix) {
                                    window.ue.count("rufusPricingIngress:desktop:uniqueClick:" + treatmentSuffix, 1);
                                }
                            }

                            window.P.when('rufus-handle-stream').execute(
                                function (stream) {
                                    if (stream) {
                                        ue && ue.count && ue.count("RUFUS_DPX_ATF_PRICE_HISTORY_SENT_TO_RUFUS_DESKTOP", 1);
                                        var payload = {
                                            qis: 'NileDPApexPriceHistory',
                                            query: ingressQueryText,
                                            metricName: 'DesktopPriceHistoryDPXIngress'
                                        };
                                        if (refMarker) {
                                            payload.refMarker = refMarker;
                                        }

                                        stream(payload);
                                    }
                                }
                            );

                            if (uex) {
                                uex('ld', "rufusPricingIngress:desktop:clickAction:latency", {wb: 1} );
                            }
                            if(csaElement) {
                                csaElement(
                                    'mark',
                                    'render-end',
                                    performance.now()
                                );
                            }
                        });
                    }
                });
            }));</script>  </div>
