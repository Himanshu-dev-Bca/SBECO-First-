  $Nav.when("config").run('ewc.pageload-content-load-wrapper', function(config) {
    P.register('ewc.pageload-content-loader', function(){
    var isEwcLoadedOnLanding = false;
    if(config.ewc.EarlyLoadEWCContentTreatment){
