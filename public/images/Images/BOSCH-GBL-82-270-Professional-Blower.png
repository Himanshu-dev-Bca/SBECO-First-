<td class="a-span9" role="presentation">    <span class="a-size-base po-break-word">47 Decibels</span>   </td> </tr>  <tr class="a-spacing-small po-included_components" role="listitem"> <td class="a-span3" role="presentation">     <span class="a-size-base a-text-bold">Included Components</span>   </td> <td class="a-span9" role="presentation">    <span class="a-size-base po-break-word">GBL 82-270 Professional (Order/Part number: 0 601 980 4F5)</span>   </td> </tr>  <tr class="a-spacing-small po-item_weight" role="listitem"> <td class="a-span3" role="presentation">     <span class="a-size-base a-text-bold">Item Weight</span>   </td> <td class="a-span9" role="presentation">    <span class="a-size-base po-break-word">1.8 Kilograms</span>   </td> </tr>  <tr class="a-spacing-small po-material" role="listitem"> <td class="a-span3" role="presentation">     <span class="a-size-base a-text-bold">Material</span>   </td> <td class="a-span9" role="presentation">    <span class="a-size-base po-break-word">Plastic</span>   </td> </tr>    </tbody></table>  </div> </div> <div id="poToggleButton" class="a-expander-header a-expander-partial-collapse-header" style="opacity: 1; display: block;"><div class="a-expander-content-fade"></div><a href="javascript:void(0)" role="button" data-action="a-expander-toggle" class="a-declarative" data-a-expander-toggle="{&quot;allowLinkDefault&quot;:true, &quot;expand_prompt&quot;:&quot;See more&quot;, &quot;collapse_prompt&quot;:&quot;See less&quot;}"><i class="a-icon a-icon-extender-expand"></i><span class="a-expander-prompt">See more</span></a></div> </div>    </div>
