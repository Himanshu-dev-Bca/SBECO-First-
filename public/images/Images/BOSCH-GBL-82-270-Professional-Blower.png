    </style>

    <!-- WLP URL -->
    <script defer="" src="./BOSCH-GBL-82-270-Professional-Blower_files/SFXInjectableScript.js.download"></script>

    <!-- ABB widget -->
    <div id="abb-widget-section" class="a-section a-spacing-base"> <div class="a-box abb-widget-box-border"><div class="a-box-inner"> <div class="a-section a-spacing-small a-text-left prime-logo"> <img alt="Amazon Prime Logo" src="./BOSCH-GBL-82-270-Professional-Blower_files/Prime_Logo_RGB_Prime_Blue_MASTER._CB542734830_.png" class="a-dynamic-image" data-a-dynamic-image="{}"> </div> <div id="abb-message" class="a-section a-spacing-none a-text-left"> <span> Enjoy <strong>Unlimited FREE Same day/1-day delivery</strong>, Prime offers everyday and more </span> </div> <div id="prime-abb-cta" class="a-section a-spacing-none a-spacing-top-base"> <a id="prime-abb-signup-button" class="a-link-normal prime-signup-button" href="https://www.amazon.in/GBL-Professional-Volumetric-Compatible-Attachments/dp/B07N11YYWR/ref=sr_1_1?adgrpid=168772406052&amp;dib=eyJ2IjoiMSJ9.CEJ0zlvH-NB9RSOICG6Kr7n_2gar5AEkIYX0FJZGnWIQqCCgUtS1gpMzwGbcYn7GWyKBVFTUzS3b7QTbOifPrhuklVPyEJohyCpPKi8iyQzT0-V8lWdbtnekHhx2idImPK9TJuca0uPpdAA2JVokHz_CzmKvH50lJ2C1v4IconeU-5wygeKR1OG6-P7-vCGsFDn-gVFpTf0PtWRQLIQXRxo3SPciYeSoFAjcp8kQzlU.vzVxIZAeQtkaOfWfs2TjupXnKu_6YkApJHnyPB_Ks1E&amp;dib_tag=se&amp;gad_source=1&amp;hvadid=779192580461&amp;hvdev=c&amp;hvexpln=0&amp;hvlocphy=9062015&amp;hvnetw=g&amp;hvocijid=10575122398740656652--&amp;hvqmt=b&amp;hvrand=10575122398740656652&amp;hvtargid=kwd-2261998702540&amp;hydadcr=9250_2368601&amp;keywords=bosch%2Bgbl%2B82%2B270%2Bblower&amp;mcid=81af2ed7619c341cba97eeed014e5923&amp;qid=1784686266&amp;sr=8-1&amp;th=1#" role="button"> <strong>Join Prime &gt;&gt;</strong> </a> </div> <script type="text/javascript">(function(f) {var _np=(window.P._namespace("PrimeABB"));if(_np.guardFatal){_np.guardFatal(f)(_np);}else{f(_np);}}(function(P) {
                const wlpParams = {
                    clientId: "PrimeAcquisition",
                    ingressId: "DetailPage",
                    redirectURL: "L2RwL2dsYW5jZS9CMDdOMTFZWVdSP2NsaWVudElkPVByaW1lQWNxdWlzaXRpb24maW5ncmVzc0lkPURldGFpbFBhZ2U=",
                    primeCampaignId: "detailPagePrimeUpsell"
                }

                
                    wlpParams.errorRedirectURL = "L2RwL2dsYW5jZS9CMDdOMTFZWVdSP2NsaWVudElkPVByaW1lQWNxdWlzaXRpb24maW5ncmVzc0lkPURldGFpbFBhZ2U=";
                

                P.when("sfx-injectable").execute("attach-wlp-signup", async (injectableAPI) => {
                    try {
                        // Get the specific WLP experience that is determined through wlpParams
                        let experienceUUID = injectableAPI.initiate(wlpParams, {});

                        // Add onclick event listener to display WLP widget when customer clicks the ABB CTA
                        const abbSignupCta = document.getElementById("prime-abb-signup-button");
                        abbSignupCta.onclick = () => {
                            injectableAPI.show(experienceUUID);
                        }

                        // Handle SPACE key event for ABB CTA
                        if (abbSignupCta) {
                            abbSignupCta.addEventListener('keydown', (event) => {
                                if (event.keyCode === 32 || event.key === ' ') {
                                    event.preventDefault();
                                    abbSignupCta.click();
                                }
                            });
                        }

                        // In the case of a sign-in redirect, check URL "loadInjectable" query param for match with
                        // clientId + ingressId. If matching, display WLP popup. This is to match previous injectable
                        // behavior whereby when customer signs in from WLP, the popup would be displayed upon redirect
                        //
                        // Query param structure: loadInjectable=[clientId]_[ingressId]
                        const queryString = window.location.search;
                        const queryParams = new URLSearchParams(queryString);
                        const loadInjectableIds = queryParams.get("loadInjectable");
                        if (loadInjectableIds && loadInjectableIds.includes('_')) {
                            const [redirectClientId, redirectIngressId] = loadInjectableIds.split("_");
                            if (redirectClientId === wlpParams.clientId && redirectIngressId === wlpParams.ingressId) {
                                injectableAPI.show(experienceUUID);
                            }
                        }
                    } catch (error) {
                        console.error('PrimeABB error invoking WLP:', error);
                    }
                })
            }));</script> </div></div> </div>                          </div>
